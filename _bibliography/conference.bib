@inproceedings{Miner-epew14,
    abbr = "C17",
    author = "Junaid Babar and Andrew Miner",
    title = "Explicit State Space and {M}arkov Chain Generation Using Decision Diagrams",

    booktitle = "11th European Workshop on Performance Engineering (EPEW'14)",

    month = sep,
    year = 2014,
    pages = "240--254",
    series = "LNCS 8721",
    doi = {10.1007/978-3-319-10885-8_17},
    pdf = "2014-EPEW-ddexplicit.pdf",
    ratio = "Acceptance rate 18/30",
    effort="45\%",
    abstract={
        Various forms of decision diagrams have been successfully used
        for quite some time to generate the state space and Markov chain from
        models expressed in some high–level formalism. A variety of
        efficient, “symbolic” algorithms, which manipulate sets of
        states instead of individual states, are known for this purpose.
        However, there are cases where explicit generation algorithms
        are still used. This paper seeks to efficiently use decision
        diagrams as replacement data structures within an existing
        explicit generation implementation. The necessary decision
        diagram algorithms are presented, and small changes to the
        explicit generation algorithm are suggested to improve the
        overall generation process. The efficiency of the new algorithms
        is illustrated using several models.
    }
}


@inproceedings{Miner-meddly-qest10,
    abbr = "C16",
    author = "Junaid Babar and Andrew Miner",
    title = "Meddly: {M}ulti--terminal and {E}dge--valued {D}ecision {D}iagram {L}ibrar{Y}",
    booktitle = "7th Int.\ Conf. on Quantitative Evaluation of Systems (QEST'10)",
    month = sep,
    year = 2010,
    address = "Williamsburg, VA, USA",
    editor = "Gianfranco Ciardo and Roberto Segala",
    pages = "195--196",
    synopsis="Tool description and first release of MEDDLY software \cite{MEDDLY-oldurl}",
    pdf = "2010-QEST-meddly.pdf",
    abstract={
        This paper introduces Meddly (Multi-terminal and Edge-valued
        Decision Diagram LibrarY), an open-source C/C++ library designed
        from its conception to support Multi-Terminal and Edge-Valued
        Decision Diagrams.  We highlight Meddly’s simple and expert
        interfaces, its loosely-coupled architecture, and the operations
        available on decision diagrams and conclude with some
        performance data.
    }
}


@inproceedings{Miner-CTML-2010,
    abbr = "C15",
    author = "Andrew S. Miner and Yaping Jing",
    title = "A Formal Language toward the Unification of Model Checking and Performance Evaluation",

    booktitle = "17th Int. Conf. on Analytical and Stochastic Modelling Techniques and Applications (ASMTA'10)",

    MONTH = jun,
    YEAR = 2010,
    PAGES = "130--144",
    series = "LNCS 6148",
    KEYWORDS = {CTML},
    doi = "10.1007/978-3-642-13568-2_10",
    pdf = "2010-ASMTA-ctml.pdf",
    effort="70\%",
    abstract={
        There are currently a variety of logics used to describe properties
        of discrete–state systems, such as linear temporal logic (LTL) and
        computation tree logic (CTL), and of discrete–state stochastic systems,
        such as probabilistic CTL (PCTL) and continuous stochastic logic (CSL).
        While powerful, these logics are by definition limited to producing
        only true or false responses. In this work, we introduce a query
        language, CTML, that operates on real–valued quantities to reason over
        probabilistic systems. CTML is inspired by, and evolves from stochastic
        logic. It extends until and weak until with arithmetic operations on
        real values, while still preserving their conventional semantics of
        temporal logic. We derive mathematical algorithms for computing each
        of the operators, show how any PCTL property can be expressed in CTML,
        and illustrate the expressiveness of CTML with some example
        performance–related queries.
    }
}


@inproceedings{Meddly-GreatSPN-2010,
    abbr = "C14",
    author = "Junaid Babar and Marco Beccuti and Susanna Donatelli and Andrew Miner",
    title = "{GreatSPN} Enhanced with Decision Diagram Data Structures",

    booktitle="Application and Theory of Petri Nets 2010",
    series = "LNCS 6128",
    MONTH = jun,
    YEAR = 2010,
    pages = "308--317",
    KEYWORDS = {Meddly, MDD},
    ratio = "Acceptance rate: 16/50",
    effort="20\%",
    doi = "10.1007/978-3-642-13675-7_19",
    pdf = "2010-ICATPN-greatspn.pdf",
    abstract = {
        Decision diagrams (DDs) have made their way into Petri net (PN)
        tools either in the form of new tools (usually designed from scratch
        to use DDs) or as enhancements to existing tools. This paper describes
        how an existing and established tool (GreatSPN) has been enhanced
        through the use of DDs provided by an existing open-source library
        (Meddly). We benchmark the enhanced tool and discuss lessons
        learned while integrating DDs into GreatSPN.
    }
}


@inproceedings{Miner-sat-qest04,
    abbr = "C13",
    author = "Andrew S. Miner",
    title = "Saturation for a general class of models",
    booktitle = "1st Int.\ Conf. on Quantitative Evaluation of Systems (QEST'04)",
    month = sep,
    year = 2004,
    address = "Enschede, The Netherlands",
    editor = "Giuliana Franceschinis and Joost-Pieter Katoen and Murray Woodside",
    pages = "282--291",
    ratio = "Acceptance rate 28/80",
    doi = "10.1109/QEST.2004.1348042",
    pdf = "2004-QEST-satur.pdf",
    abstract = {
        Implicit techniques for construction and representation
        of the reachability set of a high-level model have become
        quite efficient for certain types of models. In particular, previous
        work developed a “saturation” algorithm that exploits
        asynchronous behavior to efficiently construct the
        reachability set using multiway decision diagrams, but requires
        each model event to be expressible as a Kronecker
        product. In this paper, we develop a new version of the saturation
        algorithm that works for a general class of models:
        models whose events are not necessarily expressible as
        Kronecker products, models containing events with complex
        priority structures, and models whose state variables have
        unknown bounds. We apply our algorithm to several examples
        and give detailed experimental results.
    }
}


@inproceedings{Miner-MCclass-qest04,
    abbr = "C12",
    author = "Andrew S. Miner and Shuxing Cheng",
    title = "Improving efficiency of implicit {M}arkov chain state classification",
    booktitle = "1st Int.\ Conf. on Quantitative Evaluation of Systems (QEST'04)",
    month = sep,
    year = 2004,
    address = "Enschede, The Netherlands",
    editor = "Giuliana Franceschinis and Joost-Pieter Katoen and Murray Woodside",
    pages = "262--271",
    ratio = "Acceptance rate 28/80",
    effort="70\%",
    doi = "10.1109/QEST.2004.1348040",
    pdf = "2004-QEST-dist.pdf",
    abstract = {
        Current efficient symbolic methods to classify the states
        of a Markov chain into transient and recurrent classes use
        an iterative approach, where each iteration begins by selecting
        a “seed” state. In this paper we present heuristics to
        reduce the number of iterations required. Our core contribution
        is the use of shortest distance information to select
        the seed state. Our approach uses multiway decision diagrams
        to represent sets of states and edge-valued decision
        diagrams to represent distance information. Experimental
        results indicate that the distance heuristics can be quite effective,
        often minimizing the required number of iterations.
    }
}


@inproceedings{Wang-oneclasssvm,
    abbr = "C11",
    author = "Yanxin Wang and Johnny Wong and Andrew Miner",
    title = "Novel machine learning techniques for anomaly intrusion detection",
    booktitle = "Proceedings of the 10th Americas Conf. on Information Systems",
    address = "New York, NY",
    month = aug,
    year = 2004,
    pages = "4433--4440"
}


@inproceedings{Wang-svm,
    abbr = "C10",
    author = "Yanxin Wang and Johnny Wong and Andrew Miner",
    title = "Anomaly intrusion detection using one class {SVM}",
    booktitle = "5th Annual IEEE Information Assurance Workshop",
    address = "West Point, NY",
    publisher = "IEEE",
    month = jun,
    year = 2004,
    pages = "358--364",
    pdf = "2004-IAW-intrusion.pdf",
    abstract = {
        Kernel methods are widely used in statistical learning (or
        many fields, such as protein classification and image processing). We
        recently extend kernel methods to intrusion detection domain by
        introducing a new family of kernels suitable for intrusion
        detection. These kernels, combined with an unsupervised learning
        method - one-class Support Vector Machine, are used for anomaly
        detection. Our experiments show that the new anomaly detection
        methods are able to achieve better accuracy rates than the
        conventional anomaly detectors.
    }
}


@inproceedings{GFC-SMART-Tools03,
    abbr = "C09",
    AUTHOR = "Gianfranco Ciardo and Robert Jones and Andrew Miner and Radu
        Siminiceanu",
    TITLE = "Logical and stochastic modeling with {SMART}",
    booktitle = "13th Int.\ Conf.\ on Modelling Techniques and Tools for Computer Performance Evaluation",
    year = 2003,
    ADDRESS = "Urbana, IL, USA",
    MONTH = sep,
    SERIES = {LNCS 2794},
    EDITOR = "Peter Kemper and William H. Sanders",
    PAGES = {78--97},
    PUBLISHER = "Springer",
    ratio = "Acceptance rate 17/37",
    doi = "10.1007/b12028",
    pdf = "2003-TOOLS-smart.pdf",
    abstract = {
        We describe the main features of SMART, a software package providing
        a seamless environment for the logic and probabilistic analysis of
        complex systems. SMART can combine diﬀerent formalisms in the same
        modeling study. For the analysis of logical behavior, both explicit and
        symbolic state-space generation techniques, as well as symbolic CTL
        model-checking algorithms, are available. For the study of stochastic
        and timing behavior, both sparse-storage and Kronecker numerical
        solution approaches are available when the underlying process is a
        Markov chain. In addition, discrete-event simulation is always
        applicable regardless of the stochastic nature of the process, but
        certain classes of non-Markov models can still be solved numerically.
        Finally, since SMART targets both the classroom and realistic
        industrial settings as a learning, research, and application tool, it
        is written in a modular way that allows for easy integration of new
        formalisms and solution algorithms.
    }
}


@inproceedings{Miner-distributions03,
    abbr = "C08",
    AUTHOR = "Andrew S. Miner",
    TITLE = "Computing response time distributions using stochastic {P}etri nets
        and matrix diagrams",
    booktitle = "10th Int.\ Workshop on {P}etri Nets and Performance Models (PNPM'03)",
    year = 2003,
    EDITOR = "Gianfranco Ciardo and William H. Sanders",
    PUBLISHER = ieeecsp,
    PAGES = {10--19},
    ADDRESS = {Urbana-Champaign, IL, USA},
    MONTH = sep,
    pdf = "2003-PNPM-distro.pdf",
    abstract = {
        In this paper, we consider random variables expressed
        in terms of the time required for the state of a stochastic
        Petri net to pass from a set of starting markings to a set
        of stopping markings. These random variables have continuous
        phase-type distributions when the all transitions
        have exponentially-distributed firing delays. We demonstrate
        how to numerically compute the distribution of the
        random variable using both explicit techniques and an implicit
        approach based on multi-way decision diagrams and
        matrix diagrams. We present an efficient matrix-vector multiplication
        algorithm for matrix diagrams that is necessary
        for numerical solution. We demonstrate the efficiency of
        our approaches using several models. The lower storage
        requirements of the implicit approach effectively increases
        the size of models that can be analyzed by about an order of
        magnitude.
    }
}


@inproceedings{Miner-pmccs03,
    abbr = "C07",
    AUTHOR = "Andrew S. Miner and Shuxing Cheng",
