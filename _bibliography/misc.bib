@inproceedings{ASM-FSPNs-1995,
    abbr = "M00",
    author = "David M. Nicol and Andrew S. Miner",
    title = "The Fluid Stochastic {P}etri Net Simulator",
    booktitle = "6th Int.\ Workshop on {P}etri Nets and Performance Models (PNPM'95)",
    publisher = ieeecsp,
    pages = "214--215",
    address = {Durham, NC},
    month = oct,
    year = 1995,
    doi = "10.1109/PNPM.1995.524335",
    abstract = {
        A Fluid Stochastic Petri Net (FSPN) extends a normal Petri net
        with the notion of fluid places, and fluid arcs. Fluid levels
        are continuous, and may be used to approximate the presence of
        many discrete tokens. We describe an FSPN simulation tool whose
        input description extends the syntax of the widely used tool SPNP.
    }
}


