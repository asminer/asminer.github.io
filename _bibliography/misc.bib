@INPROCEEDINGS{GFC-MatrixDiagrams-99,
AUTHOR = {Ciardo, Gianfranco and Miner, Andrew S.},
TITLE = {{A data structure for the efficient Kronecker solution of GSPNs}},
BOOKTITLE = pnpm99,
ADDRESS = {Zaragoza, Spain},
EDITOR = {Buchholz, Peter},
PUBLISHER = ieeecsp,
PAGES = {22--31},
MONTH = sep,
YEAR = 1999,
LOCATION = {inbook},
ABSTRACT = {
Kronecker-based approaches have been proposed for the
solution of structured GSPNs with extremely large state spaces.
Representing the transition rate matrix using Kronecker sums and products
of smaller matrices virtually eliminates its storage requirements,
but introduces various sources of overhead.
We show how, by using a new data structure which we call
matrix diagrams, we are able to greatly reduce or eliminate
many of these overheads, resulting in a very efficient overall solution process.
},
KEYWORDS = {},
ratio = "Acceptance rate 18/40",
effort="50\%",
synopsis="Combines Kronecker representations with decision diagrams
  for representing large Markov chains
    about as efficiently as Kronecker sums and products,
    but allowing for more efficient solution algorithms",
links = "\href{http://dx.doi.org/10.1109/PNPM.1999.796529}{DOI} \href{Pdfs/1999PNPM.pdf}{PDF} \href{https://iastate.box.com/s/w9stbj8frcw115aod3kq2272mteqlmd8}{Box}"
}

@INPROCEEDINGS{GFC-DecisionDiagrams-99,
AUTHOR = {Miner, Andrew S. and Ciardo, Gianfranco},
TITLE = {{Efficient reachability set generation and storage
using decision diagrams}},
BOOKTITLE = icatpn99,
ADDRESS = "Williamsburg, VA, USA",
MONTH = jun,
SERIES = {LNCS 1639},
EDITOR = {Kleijn, H.C.M. and Donatelli, Susanna},
PAGES = {6--25},
PUBLISHER = springer,
YEAR = 1999,
LOCATION = {},
ABSTRACT = {
We present a new technique for the generation and storage of the
reachability set of a Petri net.  Our approach is inspired by previous
work on Binary and Multi-valued Decision Diagrams but exploits a
concept of locality for the effect of a transition's firing to vastly
improve algorithmic performance.  The result is a data structure and a
set of manipulation routines that can be used to generate and store
enormous sets extremely efficiently in terms of both memory and
execution time.},
KEYWORDS = {},
ratio = "Acceptance rate 21/45",
effort="50\%",
synopsis="Uses decision diagrams to generate reachable states of a Petri net;
algorithm exploits transition locality to improve performance",
links = "\href{http://dx.doi.org/10.1007/3-540-48745-X_2}{DOI} \href{Pdfs/1999ICATPN.pdf}{PDF} \href{https://iastate.box.com/s/yxt1wmsn3qp85l2se1rtl9ss9ada91zv}{Box}"
}

@INPROCEEDINGS{GFC-Storage-Tools-97,
